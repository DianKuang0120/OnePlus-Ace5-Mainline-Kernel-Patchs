+/*
+ * qcomtee_memobj_tzmem_init() - create a memory object from a TZ memory pool.
+ * The object owns @base and @pool; @aligned is the (possibly 4M-aligned)
+ * image within it and @size is the image length exposed to QTEE.
+ */
+int qcomtee_memobj_tzmem_init(struct qcomtee_object **object,
+			      struct qcom_tzmem_pool *pool,
+			      void *base, void *aligned, size_t size)
+{
+	struct qcomtee_mem_object *mem_object __free(kfree) =
+		kzalloc_obj(*mem_object);
+	int err;
+
+	if (!mem_object)
+		return -ENOMEM;
+
+	err = qcomtee_object_user_init(&mem_object->object,
+				       QCOMTEE_OBJECT_TYPE_CB,
+				       &qcomtee_mem_object_ops, "tzmem-%zu",
+				       size);
+	if (err)
+		return err;
+
+	mem_object->paddr = qcom_tzmem_to_phys(aligned);
+	mem_object->size = size;
+	mem_object->tzmem_pool = pool;
+	mem_object->tzmem_base = base;
+
+	*object = &no_free_ptr(mem_object)->object;
+	return 0;
+}
+
+/* Create a memory object that owns one reference to @shm. */
+int qcomtee_memobj_shm_init(struct qcomtee_object **object,
+			    struct tee_shm *shm)
+{
+	struct qcomtee_mem_object *mem_object __free(kfree) =
+		kzalloc_obj(*mem_object);
+	int err;
+
+	if (!mem_object)
+		return -ENOMEM;
+
+	err = qcomtee_object_user_init(&mem_object->object,
+				       QCOMTEE_OBJECT_TYPE_CB,
+				       &qcomtee_mem_object_ops, "tee-shm-%d",
+				       shm->id);
+	if (err)
+		return err;
+
+	mem_object->paddr = shm->paddr;
+	mem_object->size = shm->size;
+	mem_object->shm = shm;
+	*object = &no_free_ptr(mem_object)->object;
+
+	return 0;
+}
+
