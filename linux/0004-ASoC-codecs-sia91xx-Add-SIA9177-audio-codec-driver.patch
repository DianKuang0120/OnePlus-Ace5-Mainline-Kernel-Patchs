--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -250,6 +250,7 @@
 	imply SND_SOC_SDW_MOCKUP
 	imply SND_SOC_SGTL5000
 	imply SND_SOC_SI476X
+	imply SND_SOC_SIA91XX
 	imply SND_SOC_SIMPLE_AMPLIFIER
 	imply SND_SOC_SIMPLE_MUX
 	imply SND_SOC_SMA1303
@@ -2048,6 +2049,17 @@
 	tristate
 	depends on MFD_SI476X_CORE
 
+config SND_SOC_SIA91XX
+	tristate "SI-IN SIA91xx smart amplifiers"
+	depends on I2C
+	select REGMAP_I2C
+	select CRC32
+	help
+	  Enable support for SI-IN SIA91xx digital smart amplifiers
+	  (currently SIA9177). The chip register sequences are read
+	  from the vendor parameter blob "sipa.bin", which must be
+	  present in the firmware search path at first playback.
+
 config SND_SOC_SIGMADSP
 	tristate
 	select CRC32
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -293,6 +293,7 @@
 snd-soc-sgtl5000-y := sgtl5000.o
 snd-soc-alc5623-y := alc5623.o
 snd-soc-alc5632-y := alc5632.o
+snd-soc-sia91xx-y := sia91xx.o
 snd-soc-sigmadsp-y := sigmadsp.o
 snd-soc-sigmadsp-i2c-y := sigmadsp-i2c.o
 snd-soc-sigmadsp-regmap-y := sigmadsp-regmap.o
@@ -731,6 +732,7 @@
 obj-$(CONFIG_SND_SOC_RTQ9128)	+= snd-soc-rtq9128.o
 obj-$(CONFIG_SND_SOC_SDW_MOCKUP)     += snd-soc-sdw-mockup.o
 obj-$(CONFIG_SND_SOC_SGTL5000)  += snd-soc-sgtl5000.o
+obj-$(CONFIG_SND_SOC_SIA91XX)	+= snd-soc-sia91xx.o
 obj-$(CONFIG_SND_SOC_SIGMADSP)	+= snd-soc-sigmadsp.o
 obj-$(CONFIG_SND_SOC_SIGMADSP_I2C)	+= snd-soc-sigmadsp-i2c.o
 obj-$(CONFIG_SND_SOC_SIGMADSP_REGMAP)	+= snd-soc-sigmadsp-regmap.o
