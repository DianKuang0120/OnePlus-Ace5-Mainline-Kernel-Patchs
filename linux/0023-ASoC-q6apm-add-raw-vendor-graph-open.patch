+/*
+ * Optional raw module parameters to be embedded in APM_CMD_GRAPH_OPEN.
+ *
+ * Vendor voice graphs (e.g. the OPVE module 0x1700e900) are rejected by the
+ * DSP at graph-open time unless their non-persistent ACDB calibration blobs
+ * are supplied as module properties in the graph-open payload.  The blobs are
+ * read from /lib/firmware/qcom/apm-g<graph-id>-open-params.bin, in the ACDB
+ * non-persistent calibration format:
+ *
+ *   [u32 iid][u32 pid][u32 size][u32 error][data, padded to 8 bytes]
+ */
+#define APM_MAX_OPEN_PARAMS	32
+
+struct apm_open_param {
+	u32 iid;
+	u32 pid;
+	u32 size;
+	const u8 *data;
+};
+
+struct apm_open_params {
+	struct apm_open_param param[APM_MAX_OPEN_PARAMS];
+	int num;
+	const struct firmware *fw;
+};
+
+static void apm_load_open_params(struct device *dev, u32 graph_id,
+				 struct apm_open_params *op)
+{
+	char name[64];
+	const struct firmware *fw;
+	const u8 *buf;
+	size_t off = 0;
+
+	memset(op, 0, sizeof(*op));
+
+	snprintf(name, sizeof(name), "qcom/apm-g%u-open-params.bin", graph_id);
+	if (request_firmware(&fw, name, dev))
+		return;
+
+	buf = fw->data;
+	while (off + 16 <= fw->size && op->num < APM_MAX_OPEN_PARAMS) {
+		u32 iid = get_unaligned_le32(buf + off);
+		u32 pid = get_unaligned_le32(buf + off + 4);
+		u32 size = get_unaligned_le32(buf + off + 8);
+
+		if (off + 16 + size > fw->size)
+			break;
+
+		op->param[op->num].iid = iid;
+		op->param[op->num].pid = pid;
+		op->param[op->num].size = size;
+		op->param[op->num].data = buf + off + 16;
+		op->num++;
+		off += 16 + ALIGN(size, 8);
+	}
+
+	op->fw = fw;
+}
+
+static u32 apm_extra_props_size(const struct apm_open_params *op, u32 iid)
+{
+	u32 size = 0;
+	int i;
+
+	for (i = 0; i < op->num; i++) {
+		if (op->param[i].iid != iid)
+			continue;
+		size += ALIGN(8 + op->param[i].size, 8);
+	}
+
+	return size;
+}
+
