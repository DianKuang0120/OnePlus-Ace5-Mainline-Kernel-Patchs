+static int q6apm_send_raw_cfg(struct q6apm_graph *graph, const void *data, u32 len)
+{
+	int payload_size = ALIGN(len, 8);
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(payload_size,
+						APM_CMD_SET_CFG, 0);
+	void *p;
+
+	if (IS_ERR(pkt))
+		return -ENOMEM;
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	memcpy(p, data, len);
+	memset(p + len, 0, payload_size - len);
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
 
