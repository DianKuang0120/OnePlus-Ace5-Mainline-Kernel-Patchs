@@ -0,0 +1,33 @@
+## @file
+#  Install the bootloader device tree as gFdtTableGuid.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+[Defines]
+  INF_VERSION                    = 0x00010005
+  BASE_NAME                      = FdtDxe
+  FILE_GUID                      = 7E1A2C3B-4D5E-4F60-9A1B-2C3D4E5F6071
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = FdtDxeInitialize
+
+[Sources]
+  FdtDxe.c
+
+[Packages]
+  MdePkg/MdePkg.dec
+
+[LibraryClasses]
+  BaseLib
+  DebugLib
+  HobLib
+  UefiBootServicesTableLib
+  UefiDriverEntryPoint
+
+[Guids]
+  gFdtHobGuid
+  gFdtTableGuid
+
+[Depex]
+  TRUE
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa..5c7f0fc 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,11 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // Save the device-tree pointer handed over by the bootloader (ABL) in x0
+  // before anything clobbers it; SecMain() publishes it as an FDT HOB.
+  ldr   x9, =ASM_PFX (mDeviceTreeBase)
+  str   x0, [x9]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b3..7f286ea 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -16,8 +16,14 @@
 #include <Library/TimerLib.h>
 #include <Library/HobLib.h>
 
+#include <Guid/FdtHob.h>
+
 #include "Sec.h"
 
+// Device tree pointer passed by the bootloader (ABL) in x0.  Written from
+// ModuleEntryPoint.S before the C runtime starts, hence non-static.
+UINTN  mDeviceTreeBase = 0;
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -118,6 +124,13 @@ SecMain (VOID)
     return;
   }
 
+  // Publish the bootloader-provided device tree (carries the per-boot Gunyah
+  // Resource Manager capids injected by ABL) as an FDT HOB so FdtDxe can turn
+  // it into the EFI gFdtTableGuid configuration table.
+  if (mDeviceTreeBase != 0) {
+    BuildGuidDataHob (&gFdtHobGuid, &mDeviceTreeBase, sizeof (mDeviceTreeBase));
+  }
+
   // Build CPU HOB
   BuildCpuHob (ArmGetPhysicalAddressBits (), PcdGet8 (PcdPrePiCpuIoSize));
 
