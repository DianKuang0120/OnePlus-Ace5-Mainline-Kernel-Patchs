#!/bin/bash
set -u
PROG=/usr/local/bin/back_to_android

# 1) 确认框
yad --title="切回 Android" --image="dialog-question" --width=420 \
    --text="<b>即将把 boot.img 写入 boot_a</b>

镜像: /AndroidBoot/boot.img
大小: 192 MiB
刷完自动重启到 Android。" \
    --button="取消":1 --button="开始刷写":0 || exit 0

# 2) 真进度条：stdout 是百分比，stderr 落到 /tmp 供出错时查看
LOG=$(mktemp /tmp/back-to-android.XXXXXX.log)
"$PROG" -y 2>"$LOG" \
  | yad --progress --auto-close --no-buttons \
        --title="切回 Android — 进度" \
        --width=520 --height=140 \
        --text="正在刷写 boot.img…" \
        --percentage=0

rc=${PIPESTATUS[0]}
if [ "$rc" -ne 0 ]; then
    yad --title="失败" --image="dialog-error" --width=620 --height=400 \
        --text-info --filename="$LOG" \
        --button="关闭:0"
fi
rm -f "$LOG"