#!/usr/bin/env bash
# giulia-cam906 - one RAW frame from the 50MP main Sony IMX906 (LYT-700).
#
# Wiring on giulia (from the stock Android CSIPHY log):
#   IMX906 -> CCI0 master1 -> **CSI PHY1 -> CSID0** -> VFE0 RDI0
# (the vendor log says "CAM_START_PHYDEV: 1, CSID:0", i.e. phy1 feeds CSID0)
#
# Usage: giulia-cam906 [out.pgm] [width] [height]
set -eu

OUT=${1:-/tmp/giulia-cam906.pgm}
W=${2:-4096}
H=${3:-3072}

MEDIA=/dev/media0
MEDIA_CTL="media-ctl -d $MEDIA"

die() { echo "giulia-cam906: $*" >&2; exit 1; }
command -v media-ctl >/dev/null || die "media-ctl not found (v4l-utils)"
command -v v4l2-ctl  >/dev/null || die "v4l2-ctl not found (v4l-utils)"

ent_of() { $MEDIA_CTL -p 2>/dev/null | sed -n "s/.*entity [0-9]*: \($1[^ ]*\).*/\1/p" | head -1; }
node_of() { $MEDIA_CTL -p 2>/dev/null | awk -v e="$1" '$0 ~ "entity [0-9]+: "e" " {f=1} f && /device node name/ {print $NF; exit}'; }

SENSOR=$(ent_of "imx906"); [ -n "$SENSOR" ] || die "imx906 entity not found - is the sensor probed?"
SUBDEV=$(node_of "$SENSOR") || true
VIDEO=$(node_of "msm_vfe0_video0") || true
[ -n "${VIDEO:-}" ] || die "VFE0 RDI0 video node not found"
echo "giulia-cam906: sensor='$SENSOR' subdev=$SUBDEV video=$VIDEO"

# --- pipeline: phy1 -> csid0 -> vfe0_rdi0 ---
$MEDIA_CTL -l '"msm_csiphy1":1->"msm_csid0":0[1]'
$MEDIA_CTL -l '"msm_csid0":1->"msm_vfe0_rdi0":0[1]'
for p in "\"$SENSOR\":0" '"msm_csiphy1":0' '"msm_csiphy1":1' \
         '"msm_csid0":0' '"msm_csid0":1' '"msm_vfe0_rdi0":0'; do
    $MEDIA_CTL -V "${p}[fmt:SRGGB10_1X10/${W}x${H}]" || true
done

RAW=$(mktemp /tmp/giulia-cam906-XXXXXX.raw)
trap 'rm -f "$RAW"' EXIT
v4l2-ctl -d "$VIDEO" --set-fmt-video="width=$W,height=$H,pixelformat=pRAA"
echo "  - streaming 1 frame (15 s timeout)"
timeout 15 v4l2-ctl -d "$VIDEO" --stream-mmap --stream-count=1 --stream-to="$RAW" \
    || { echo "giulia-cam906: no frame (timeout) - check dmesg" >&2; exit 1; }

python3 - "$RAW" "$OUT" "$W" "$H" <<'PY'
import sys, numpy as np
raw, out, w, h = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
a = np.fromfile(raw, dtype=np.uint8)
d = a[: (len(a)//5)*5].reshape(-1,5).astype(np.uint16)
px = np.empty(d.shape[0]*4, dtype=np.uint16)
px[0::4] = (d[:,0] << 2) | (d[:,4] & 3)
px[1::4] = (d[:,1] << 2) | ((d[:,4] >> 2) & 3)
px[2::4] = (d[:,2] << 2) | ((d[:,4] >> 4) & 3)
px[3::4] = (d[:,3] << 2) | ((d[:,4] >> 6) & 3)
f = px[:w*h].reshape(h, w).astype(np.float32)
lo, hi = np.percentile(f, 1), np.percentile(f, 99.5)
g = np.clip((f - lo)/max(1.0, hi-lo), 0, 1)
open(out, "wb").write(b"P5\n%d %d\n255\n" % (w, h) + (g*255).astype(np.uint8).tobytes())
print("giulia-cam906: wrote %s (%dx%d, min=%d max=%d mean=%.1f)" % (out, w, h, f.min(), f.max(), f.mean()))
PY
