[Unit]
Description=giulia (OnePlus 13R / Ace 5) Qualcomm Sensor Subsystem listener
ConditionPathExists=/dev/fastrpc-adsp
After=systemd-udev-trigger.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/local/lib/giulia-ssc
ExecStart=/usr/local/libexec/giulia-ssc/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /var/lib/giulia-ssc/root
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
