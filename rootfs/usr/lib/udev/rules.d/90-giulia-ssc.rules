# Enable the giulia SSC sensors exposed through the ADSP FastRPC node.
# ACCEL_MOUNT_MATRIX: rotate 180 deg about Z (-1,-1,1).
#   The SSC accelerometer reports in the physical device frame
#   (+X right, +Y top, +Z out of the screen), while iio-sensor-proxy expects
#   (+X left, +Y down, +Z out): it returns "normal" for (0,-9.8,0) and
#   "right-up" for (-9.8,0,0) (see iio-sensor-proxy src/test-orientation.c).
#   Verified on device: with this matrix KWin auto-rotates correctly when the
#   phone is held in landscape with the front camera on the left.
# ssc-proximity is included because giulia's tcs3720 publishes proximity;
# the gyroscope has no iio-sensor-proxy backend (read it via the libssc API).
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel ssc-proximity ssc-light ssc-compass", ENV{ACCEL_LOCATION}="display", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service"
